# ============================================================
# Recruitment Matching Engine — Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND CONFIGURATION
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
GEOLOCATION_API_KEY=your_geolocation_api_key_here
VITE_GEOLOCATION_API_KEY=your_geolocation_api_key_here

# ------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL or SQLite)
# ------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/matching_engine
DATABASE_PUBLIC_URL=postgresql://username:password@localhost:5432/matching_engine
PGPORT=5432
PGPASSWORD=your_postgres_password_here
# For local SQLite development, comment above and uncomment:
# DATABASE_URL=sqlite:///./matching_engine.db

# ------------------------------------------------------------
# 3. LLM API (Sarvam-105B) CONFIGURATION
# ------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions

# ------------------------------------------------------------
# 4. STORAGE & EMBEDDINGS
# ------------------------------------------------------------
UPLOAD_DIRECTORY=./storage/job_descriptions
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------
# 5. MATCHING WEIGHTS & THRESHOLDS (Optional Defaults in %)
# ------------------------------------------------------------
WEIGHT_SKILLS=35.0
WEIGHT_EXPERIENCE=25.0
WEIGHT_RESPONSIBILITIES=15.0
WEIGHT_EDUCATION=10.0
WEIGHT_LOCATION=5.0
WEIGHT_SHIFT=5.0
WEIGHT_OTHER=5.0

THRESHOLD_STRONG_MATCH=80.0
THRESHOLD_GOOD_MATCH=70.0
THRESHOLD_PARTIAL_MATCH=60.0

# ------------------------------------------------------------
# 6. SNAPSERVE AI VOICE AGENT PLATFORM
# ------------------------------------------------------------
SNAPSERVE_API_KEY=your_snapserve_api_key_here
SNAPSERVE_BASE_URL=https://app.snapserve.ai/api

